{
  "name": "nox-browser",
  "productName": "Nox",
  "version": "0.11.0",
  "description": "Nox – ein schlanker, durchgehend dunkler Browser mit Tabs, Werbeblocker und Erweiterungen.",
  "author": "Noah",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "allowScripts": {
    "electron@39.8.10": true
  },
  "build": {
    "appId": "de.noah.nachtfalter",
    "productName": "Nox",
    "directories": {
      "output": "fertig"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "ui/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nox",
      "artifactName": "Nox-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
