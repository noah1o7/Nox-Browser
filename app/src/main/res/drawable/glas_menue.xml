<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: dunkles Blaugrau, Lichtkante oben, feiner heller Rand -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#F2242838" android:endColor="#F2151722" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:centerColor="#05FFFFFF" android:endColor="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
    <item android:left="18dp" android:right="18dp" android:top="1dp" android:bottom="0dp" android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
