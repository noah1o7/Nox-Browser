<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/glas_karte"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="6dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/karteBuchstabe"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/kugel_buchstabe"
        android:gravity="center"
        android:textColor="@color/nf_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/karteTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/nf_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/karteUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/nf_gedaempft"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/karteZu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ripple_rund"
        android:contentDescription="Tab schließen"
        android:src="@drawable/ic_schliessen" />
</LinearLayout>
