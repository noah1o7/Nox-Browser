<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nf_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Hier liegt die Webseite des aktiven Tabs -->
    <FrameLayout
        android:id="@+id/webBereich"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/leiste_platz"
        android:background="@color/nf_bg" />

    <!-- Ladefortschritt direkt über der Leiste -->
    <View
        android:id="@+id/ladeLinie"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/leiste_platz"
        android:background="@drawable/lade_linie"
        android:visibility="invisible" />

    <!-- Werkzeugleiste. Die Elevation hält sie über dem Menü, damit der Menüknopf es wieder schließen kann. -->
    <LinearLayout
        android:id="@+id/leiste"
        android:layout_width="match_parent"
        android:layout_height="@dimen/leiste_platz"
        android:layout_gravity="bottom"
        android:background="@drawable/leiste_grund"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="none"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/zurueckKnopf"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_rund"
            android:contentDescription="Zurück"
            android:src="@drawable/ic_zurueck" />

        <LinearLayout
            android:id="@+id/adressFeld"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:addStatesFromChildren="true"
            android:background="@drawable/feld_auswahl"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/schild"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Werbeblocker"
                android:src="@drawable/ic_schild"
                android:tint="@color/nf_gedaempft" />

            <TextView
                android:id="@+id/schildZahl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/nf_gedaempft"
                android:textSize="11sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/adresse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Suchen oder Adresse eingeben"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:singleLine="true"
                android:textColor="@color/nf_text"
                android:textColorHint="@color/nf_gedaempft"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/tabKnopf"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_rund"
            android:clickable="true"
            android:contentDescription="Tabs"
            android:focusable="true">

            <TextView
                android:id="@+id/tabZahl"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/tab_zaehler"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="1"
                android:textColor="@color/nf_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/menueKnopf"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_rund"
            android:contentDescription="Menü"
            android:src="@drawable/ic_menue" />
    </LinearLayout>

    <!-- Tab-Übersicht -->
    <FrameLayout
        android:id="@+id/uebersicht"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nf_bg"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:text="Tabs"
                android:textColor="@color/nf_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/kartenScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/kartenListe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/fertigKnopf"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/knopf_sekundaer"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Fertig"
                    android:textColor="@color/nf_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/neuerTabKnopf"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/knopf_primaer"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Neuer Tab"
                    android:textColor="@color/nf_bg"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Menü mit abgedunkeltem Hintergrund -->
    <FrameLayout
        android:id="@+id/menueHuelle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menue"
            android:layout_width="264dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="64dp"
            android:background="@drawable/menue_grund"
            android:clickable="true"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </FrameLayout>

    <!-- Ebene für Hinweise und die Update-Meldung -->
    <FrameLayout
        android:id="@+id/hinweisEbene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="30dp" />
</FrameLayout>
