<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Nachtfalter ist IMMER dunkel - auch wenn das Handy im hellen Modus ist -->
    <style name="Theme.Nachtfalter" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/nf_akzent</item>
        <item name="colorPrimaryVariant">@color/nf_akzent_tief</item>
        <item name="colorOnPrimary">@color/nf_bg</item>
        <item name="colorSecondary">@color/nf_akzent</item>
        <item name="colorSecondaryVariant">@color/nf_akzent_tief</item>
        <item name="colorOnSecondary">@color/nf_bg</item>
        <item name="colorAccent">@color/nf_akzent</item>
        <item name="colorControlActivated">@color/nf_akzent</item>
        <item name="colorControlHighlight">#1FFFFFFF</item>
        <item name="android:textColorHighlight">#66E8A33D</item>
        <item name="android:colorBackground">@color/nf_bg</item>
        <item name="android:windowBackground">@color/nf_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:isLightTheme" tools:targetApi="29">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/nf_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/nf_bg</item>
    </style>
</resources>
